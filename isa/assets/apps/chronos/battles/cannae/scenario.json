":300,"lon":16.131674,"lat":41.317158}]},{"id":"carth_inf_spanish_1","name":"Spanish infantry, centre II","side":"carthage","type":"light_infantry","strength":8000,"anchors":[{"t":0,"lon":16.132631,"lat":41.316619},{"t":30,"lon":16.131913,"lat":41.316619},{"t":70,"lon":16.13012,"lat":41.316619},{"t":120,"lon":16.131315,"lat":41.316619},{"t":170,"lon":16.131794,"lat":41.316619},{"t":220,"lon":16.131913,"lat":41.316619},{"t":300,"lon":16.131794,"lat":41.316619}]},{"id":"carth_inf_gallic_2","name":"Gallic infantry, centre III","side":"carthage","type":"light_infantry","strength":8000,"anchors":[{"t":0,"lon":16.132631,"lat":41.315002},{"t":30,"lon":16.131913,"lat":41.315002},{"t":70,"lon":16.130239,"lat":41.315181},{"t":120,"lon":16.131196,"lat":41.315451},{"t":170,"lon":16.131674,"lat":41.31599},{"t":220,"lon":16.131794,"lat":41.316259},{"t":300,"lon":16.131674,"lat":41.316439}]},{"id":"carth_inf_african_right","name":"African veteran infantry (south flank)","side":"carthage","type":"heavy_infantry","strength":4000,"anchors":[{"t":0,"lon":16.135381,"lat":41.313205},{"t":30,"lon":16.135022,"lat":41.313205},{"t":70,"lon":16.134185,"lat":41.313475},{"t":120,"lon":16.133348,"lat":41.314103},{"t":170,"lon":16.131435,"lat":41.315002},{"t":220,"lon":16.130239,"lat":41.315631},{"t":300,"lon":16.13012,"lat":41.31608}]},{"id":"carth_skirmishers","name":"Carthaginian skirmishers","side":"carthage","type":"light_infantry","strength":2000,"anchors":[{"t":0,"lon":16.131794,"lat":41.31572},{"t":30,"lon":16.130239,"lat":41.31581},{"t":70,"lon":16.132152,"lat":41.31572},{"t":120,"lon":16.131196,"lat":41.31581},{"t":170,"lon":16.130717,"lat":41.31617},{"t":220,"lon":16.130478,"lat":41.316439},{"t":300,"lon":16.130359,"lat":41.316529}]}],"phases":[{"t":0,"caption":"Deployment: Hannibal's ~50,000 form a forward-bulging crescent -- Gallic and Spanish infantry in the centre, African veteran infantry held back on both flanks. Rome's ~60,000+ mass their heavy infantry in unusually deep ranks, citizen cavalry anchored on the river (right), allied cavalry in the open plain (left)."},{"t":30,"caption":"Skirmish: velites and Carthaginian light troops trade missiles in the gap between the lines, then fall back behind their own formations."},{"t":70,"caption":"The crescent advances and bulges toward Rome; the Roman infantry presses forward hard into the centre. Hasdrubal's heavy cavalry charges home against the Roman citizen cavalry by the river."},{"t":120,"caption":"Hasdrubal routs the Roman right-wing cavalry, which had no room to manoeuvre with the river at its back. The Gallic/Spanish centre begins giving ground -- the crescent starts bending concave as the Romans drive deeper into it."},{"t":170,"caption":"The centre is now a controlled withdrawal, drawing the packed Roman ranks into a pocket. Numidian light cavalry pins the Roman allied cavalry on the far wing. Hasdrubal's cavalry, victorious by the river, rides behind the Roman line toward the Roman rear -- African veteran infantry begin wheeling inward on both flanks."},{"t":220,"caption":"Hasdrubal's cavalry falls on the Roman allied cavalry from behind; it breaks and flees. The African veterans complete their wheel and press directly into the exposed Roman flanks."},{"t":300,"caption":"Encirclement complete: the compressed Roman mass is surrounded on every side -- centre, both flanks, and rear -- the double envelopment that made Cannae a byword for annihilation."}]}