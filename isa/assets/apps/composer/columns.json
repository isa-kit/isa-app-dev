{
  "boards": [
    { "name": "id", "type": "text" },
    { "name": "name", "type": "text", "label": "Name" },
    { "name": "order", "type": "number", "label": "Order", "hidden": true },
    { "name": "style", "type": "text", "label": "Style", "hidden": true, "default": "" },
    { "name": "accent", "type": "text", "label": "Accent", "hidden": true, "default": "" }
  ],
  "screens": [
    { "name": "id", "type": "text" },
    { "name": "board", "type": "text", "label": "Board", "hidden": true },
    { "name": "name", "type": "text", "label": "Name" },
    {
      "name": "device",
      "type": "enum",
      "label": "Device",
      "options": ["phone", "tablet", "web", "fragment"],
      "default": "phone"
    },
    { "name": "x", "type": "number", "label": "X", "hidden": true, "default": 0 },
    { "name": "y", "type": "number", "label": "Y", "hidden": true, "default": 0 },
    { "name": "width", "type": "number", "label": "Width", "hidden": true },
    {
      "name": "variantOf",
      "type": "text",
      "label": "Variant of",
      "hidden": true
    },
    {
      "name": "folder",
      "type": "text",
      "label": "Folder",
      "hidden": true,
      "default": ""
    }
  ],
  "widgets": [
    { "name": "id", "type": "text" },
    { "name": "screen", "type": "text", "label": "Screen", "hidden": true },
    {
      "name": "kind",
      "type": "enum",
      "label": "Kind",
      "options": [
        "titlebar", "searchbar", "tabs", "scrollview", "list", "settings",
        "text", "card", "image", "buttonrow", "bottomnav", "fab", "row"
      ]
    },
    { "name": "label", "type": "text", "label": "Label" },
    {
      "name": "region",
      "type": "enum",
      "label": "Region",
      "options": ["top", "body", "bottom", "overlay"]
    },
    { "name": "order", "type": "number", "label": "Order", "hidden": true, "default": 0 },
    {
      "name": "intent",
      "type": "enum",
      "label": "Size intent",
      "options": ["fixed", "fill", "wrap"],
      "hidden": true
    },
    { "name": "behavior", "type": "text", "label": "Behavior", "hidden": true, "default": "" },
    { "name": "parent",  "type": "text",   "label": "Parent",  "hidden": true },
    { "name": "cell",    "type": "number", "label": "Cell",    "hidden": true, "default": 0 },
    { "name": "cols",    "type": "number", "label": "Columns", "hidden": true, "default": 2 },
    { "name": "weights", "type": "text",   "label": "Weights", "hidden": true },
    { "name": "items",   "type": "text",   "label": "Items",   "hidden": true, "default": "" }
  ],
  "flows": [
    { "name": "id", "type": "text" },
    { "name": "board", "type": "text", "label": "Board", "hidden": true },
    { "name": "fromWidget", "type": "text", "label": "From widget", "hidden": true },
    { "name": "toScreen", "type": "text", "label": "To screen", "hidden": true },
    {
      "name": "transition",
      "type": "enum",
      "label": "Transition",
      "options": ["push", "fade", "sheet"],
      "default": "push"
    }
  ]
}
