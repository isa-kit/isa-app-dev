  "confidence_tiers": [
    {
      "id": "tier_focused",
      "tier": "focused (calibrated)",
      "meaning": "Real, observed, sourced LOCAL targets; calibration converged inside the stated tolerance; at least one independent cross-check exists. These numbers may inform decisions, with residuals shown.",
      "earned_by": "Sourced ACS B08301 transit share + NHTS-anchored trip length, in-tolerance calibration, and an independent cross-check (e.g. NTD boardings held out of the fit).",
      "downgrades": "Editing the label does NOT promote a run — promotion is earned only by the rows. A run drops to exploratory if targets become approximate anchors, the ACS key is missing, or calibration falls out of tolerance.",
      "decisions": "May inform decisions (with residuals shown). Suited to a funded corridor study.",
      "cities": "Boston, Chicago, Seattle"
    },
    {
      "id": "tier_exploratory",
      "tier": "exploratory (transferred)",
      "meaning": "Targets are national / peer anchors (NCHRP-716-style transfer); the vintage says 'exploratory'; tolerance is looser. Structurally the same model, honestly weaker grounding.",
      "earned_by": "Runs against approximate national-anchor targets pending real per-metro ACS pulls (usm_* metro configs).",
      "downgrades": "Downgraded by: approximate 'exploratory 2019-anchor' targets; a missing ACS API key (can't fetch per-metro B08301); a dense-core bbox that clips the metro; aggregate national anchors used in place of per-metro observed targets.",
      "decisions": "For coverage, comparison, and exploration — NOT a forecast, NOT a basis for a specific investment decision.",
      "cities": "most of the 382 US metros (usm_* configs)"
    }
  ],
