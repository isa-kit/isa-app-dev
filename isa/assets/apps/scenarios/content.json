  "standards": [
    {
      "id": "st_fhwa",
      "standard": "FHWA Travel Model Validation & Reasonableness Checking Manual (2010)",
      "requires": "Check every four-step stage against observed data (trip rates, trip-length distributions, mode shares vs census JTW, assigned volumes vs counts); assess reasonableness of magnitudes/gradients; validate against data NOT fit to.",
      "met": "partial"
    },
    {
      "id": "st_nchrp",
      "standard": "NCHRP Report 716 - Parameters and Techniques",
      "requires": "For transferred (not locally-estimated) parameters, declare them, anchor to a national/peer source (NHTS), and class transferred results as a different confidence tier than calibrated ones.",
      "met": "yes"
    },
    {
      "id": "st_tmip",
      "standard": "TMIP peer-review practice",
      "requires": "Reviewability: complete written methodology, traceable data lineage, reproducible runs, honest limitations statement - the package a panel could audit without the authors present.",
      "met": "partial"
    },
    {
      "id": "st_stops",
      "standard": "FTA STOPS-style calibration norms",
      "requires": "Calibrate to observed transit targets (census JTW share, NTD boardings), report the achieved-vs-target residual, keep the local adjustment surface small and documented so cities stay comparable.",
      "met": "partial"
    }
  ],
