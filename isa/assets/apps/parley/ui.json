{
  "app": {
    "appDataTools": true,
    "title": "Parley",
    "primaryColor": "#2E7D6B",
    "theme": "pastel",
    "liveSeconds": 2
  },
  "nav": [
    { "id": "chat", "label": "Chat", "icon": "forum", "screen": "chat" },
    { "id": "learn", "label": "Learn", "icon": "school", "screen": "learn" }
  ],
  "screens": {
    "chat": {
      "title": "Parley",
      "body": {
        "type": "column",
        "crossAxis": "stretch",
        "children": [
          {
            "type": "text",
            "style": "caption",
            "value": "Live chat that translates. This board's chat is here, in the app. \"Copy share link\" opens a companion web chat you can share with anyone — separate from this board's chat — and copies its link so you can send it. Pick your language below -- it shows right here once set. Sent messages briefly show \"Translating…\"; if translation isn't available your message still sends, marked as untranslated. Messages are sent to an online translation service to be translated."
          },
          {
            "type": "button",
            "label": "Copy share link",
            "icon": "link",
            "action": { "fn": "hostCall", "args": { "name": "copyParleyLink" } }
          },
          {
            "type": "text",
            "style": "caption",
            "value": "Your language:"
          },
          {
            "type": "cards",
            "table": "participants",
            "filter": { "column": "id", "value": "$playerId" },
            "title": "lang",
            "valueLabels": {
              "lang": {
                "en": "English", "es": "Español", "fr": "Français", "de": "Deutsch",
                "pt": "Português", "it": "Italiano", "zh": "中文", "ja": "日本語",
                "ko": "한국어", "ar": "العربية", "hi": "हिन्दी"
              }
            },
            "emptyIcon": "translate",
            "emptyTitle": "No language set yet",
            "emptyText": "Tap a language below -- your messages translate for the other person once you pick one."
          },
          {
            "type": "text",
            "style": "caption",
            "value": "I read and write in:"
          },
          {
            "type": "row",
            "wrap": true,
            "children": [
              { "type": "button", "label": "English", "action": { "fn": "hostCall", "args": { "name": "setMyLanguage", "lang": "en" } } },
              { "type": "button", "label": "Español", "action": { "fn": "hostCall", "args": { "name": "setMyLanguage", "lang": "es" } } },
              { "type": "button", "label": "Français", "action": { "fn": "hostCall", "args": { "name": "setMyLanguage", "lang": "fr" } } },
              { "type": "button", "label": "Deutsch", "action": { "fn": "hostCall", "args": { "name": "setMyLanguage", "lang": "de" } } },
              { "type": "button", "label": "Português", "action": { "fn": "hostCall", "args": { "name": "setMyLanguage", "lang": "pt" } } },
              { "type": "button", "label": "Italiano", "action": { "fn": "hostCall", "args": { "name": "setMyLanguage", "lang": "it" } } },
              { "type": "button", "label": "中文", "action": { "fn": "hostCall", "args": { "name": "setMyLanguage", "lang": "zh" } } },
              { "type": "button", "label": "日本語", "action": { "fn": "hostCall", "args": { "name": "setMyLanguage", "lang": "ja" } } },
              { "type": "button", "label": "한국어", "action": { "fn": "hostCall", "args": { "name": "setMyLanguage", "lang": "ko" } } },
              { "type": "button", "label": "العربية", "action": { "fn": "hostCall", "args": { "name": "setMyLanguage", "lang": "ar" } } },
              { "type": "button", "label": "हिन्दी", "action": { "fn": "hostCall", "args": { "name": "setMyLanguage", "lang": "hi" } } }
            ]
          },
          { "type": "divider" },
          {
            "type": "list",
            "emptyIcon": "forum",
            "emptyTitle": "No messages yet",
            "emptyText": "Connect with a code and say hello -- messages show up here.",
            "table": "messages",
            "titleColumn": "text",
            "subtitleColumns": [
              { "fromSetting": "parleyViewCol", "fallback": "display" }
            ],
            "metaColumns": ["sender", "status"],
            "sortColumn": "sentAt",
            "sortDir": "asc",
            "bubbles": { "byColumn": "senderId", "selfValue": "$playerId" },
            "swipeActions": [
              { "label": "Save phrase", "icon": "bookmark_add", "action": { "fn": "hostCall", "args": { "name": "savePhrase" } } }
            ]
          },
          { "type": "divider" },
          {
            "type": "composer",
            "table": "messages",
            "column": "text",
            "placeholder": "Type a message…",
            "sendIcon": "send",
            "values": {
              "sender": "$playerId",
              "senderId": "$playerId",
              "sentAt": "now",
              "id": "uuid",
              "status": "Sending…",
              "display": "",
              "original": "",
              "translated": ""
            },
            "action": { "fn": "hostCall", "args": { "name": "translateMessage" } }
          }
        ]
      }
    },
    "learn": {
      "title": "Learn",
      "body": {
        "type": "column",
        "crossAxis": "stretch",
        "children": [
          {
            "type": "text",
            "style": "caption",
            "value": "Phrases you've saved from chat, and a quick way to practice them."
          },
          { "type": "stat", "table": "phrases", "agg": "count", "label": "Phrases saved" },
          { "type": "divider" },
          {
            "type": "text",
            "style": "caption",
            "value": "Practice — tap a card to reveal the translation."
          },
          {
            "type": "cards",
            "table": "phrases",
            "title": "original",
            "expandFields": [
              { "column": "translation", "label": "Translation" }
            ],
            "sortBy": "savedAt",
            "sortDir": "desc",
            "emptyIcon": "school",
            "emptyTitle": "Nothing to practice yet",
            "emptyText": "Save a phrase from the chat to practice it here."
          },
          { "type": "divider" },
          {
            "type": "text",
            "style": "caption",
            "value": "Phrasebook"
          },
          {
            "type": "list",
            "table": "phrases",
            "titleColumn": "original",
            "subtitleColumns": ["translation"],
            "metaColumns": ["srcLang", "dstLang"],
            "sortColumn": "savedAt",
            "sortDir": "desc",
            "emptyIcon": "bookmark",
            "emptyTitle": "Nothing saved",
            "emptyText": "Swipe a chat message and tap \"Save phrase\" to add it here.",
            "swipeActions": ["delete"]
          }
        ]
      }
    }
  }
}
