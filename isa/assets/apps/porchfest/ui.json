{
  "app": {
    "appDataTools": true,
    "title": "Porchfest map",
    "primaryColor": "#3F7DD9",
    "theme": "contrast"
  },
  "nav": [
    {
      "id": "map",
      "label": "Map",
      "icon": "map",
      "screen": "map"
    },
    {
      "id": "schedule",
      "label": "Schedule",
      "icon": "event_note",
      "screen": "schedule"
    },
    {
      "id": "about",
      "label": "About",
      "icon": "menu_book",
      "screen": "about"
    }
