      "type": "enum",
      "label": "Difficulty",
      "options": ["easy", "medium", "hard"],
      "default": "medium"
    },
    {
      "name": "status",
      "type": "enum",
      "label": "Status",
      "options": ["not started", "requested", "confirmed"],
      "default": "not started"
    },
    { "name": "notes", "type": "text", "label": "Notes" }
  ],
  "guides": [
    { "name": "topic", "type": "text", "label": "Topic", "required": true },
    {
      "name": "category",
      "type": "enum",
      "label": "Category",
      "options": ["how leaks happen", "what to check", "opt-out", "advanced"],
